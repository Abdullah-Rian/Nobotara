# Cloudflare Pages cache rules (Brotli compression is automatic).
# Hashed build files never change, so browsers keep them for a year.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Models, audio, video and images keep their names when replaced: reuse for a day,
# refresh in the background for a week.
/models/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/draco/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/manus-storage/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/team/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
